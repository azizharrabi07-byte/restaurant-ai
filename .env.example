# ------------------------------------------------------------------
# Supabase (the app's database, auth & storage).
# Use either a hosted Supabase project OR the local Supabase CLI.
#   Local: run `supabase start` and copy the printed URL/anon/service keys.
#   Hosted: create a project at https://supabase.com and copy its keys.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER ship this to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# OpenAI — used for the LLM (chat), vision (analysis + validation)
# and image generation. You can use the same key for all three, or
# separate keys per provider by setting the provider-specific vars.
# ------------------------------------------------------------------
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o
# The vision + chat route only fires when a valid key is present.
# Empty string disables the feature gracefully.

IMAGE_PROVIDER_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024

# ------------------------------------------------------------------
# WhatsApp / automation (optional).
# When set, order events are POSTed to this n8n webhook so you can
# build WhatsApp notifications. Leave empty to disable.
# ------------------------------------------------------------------
N8N_WEBHOOK_URL=

# ------------------------------------------------------------------
# Local URLs for reference (see README).
# App:      http://localhost:3000
# n8n:      http://localhost:5678
# Supabase: http://localhost:54321 (Supabase Studio UI)
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ------------------------------------------------------------------
# Supabase (the app's database, auth & storage).
# Use either a hosted Supabase project OR the local Supabase CLI.
#   Local: run `supabase start` and copy the printed URL/anon/service keys.
#   Hosted: create a project at https://supabase.com and copy its keys.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# Server-only. NEVER ship this to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Mistral — menu scanning ("Scan your menu" in onboarding).
# Server-only key for OCR (photos/PDFs) + menu structuring.
# ------------------------------------------------------------------
MISTRAL_API_KEY=
# Optional model override (default shown).
# Structure is produced by the OCR endpoint's built-in document annotation
# (json_schema), which runs on the OCR quota — chat/completion quotas are not
# involved.
MISTRAL_OCR_MODEL=mistral-ocr-latest

# ------------------------------------------------------------------
# Security / rate limiting.
# In-memory sliding-window rate limiter on login, order creation and menu
# scans. Set to 1 or "true" to DISABLE it (dev/tests only):
# ------------------------------------------------------------------
# SUFRA_RATE_LIMIT_DISABLED=0

# ------------------------------------------------------------------
# DEV ONLY kill-switch: SUFRA_AUTH_DISABLED=1 opens every login wall
# (owner + worker dashboards and all protected APIs) for local testing.
# It is IGNORED by production builds (NODE_ENV=production), so walls are
# always up on deployment. Unset/delete to restore auth. Never enable in
# production.
# ------------------------------------------------------------------
# SUFRA_AUTH_DISABLED=0

# ------------------------------------------------------------------
# Local URLs for reference (see README).
# App:      http://localhost:3000
# Supabase: http://localhost:54321 (Supabase Studio UI)
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
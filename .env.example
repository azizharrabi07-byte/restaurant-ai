# ------------------------------------------------------------------
# Supabase (the app's database, auth & storage).
# Use either a hosted Supabase project OR the local Supabase CLI.
#   Local: run `supabase start` and copy the printed URL/anon/service keys.
#   Hosted: create a project at https://supabase.com and copy its keys.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# Server-only. NEVER ship this to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Mistral — menu scanning ("Scan your menu" in onboarding).
# Server-only key for OCR (photos/PDFs) + menu structuring.
# ------------------------------------------------------------------
MISTRAL_API_KEY=
# Optional model override (default shown).
# Structure is produced by the OCR endpoint's built-in document annotation
# (json_schema), which runs on the OCR quota — chat/completion quotas are not
# involved.
MISTRAL_OCR_MODEL=mistral-ocr-latest

# ------------------------------------------------------------------
# Security / rate limiting.
# In-memory sliding-window rate limiter on login, order creation and menu
# scans. Set to 1 or "true" to DISABLE it (dev/tests only):
# ------------------------------------------------------------------
# SUFRA_RATE_LIMIT_DISABLED=0

# ------------------------------------------------------------------
# DEV ONLY kill-switch: SUFRA_AUTH_DISABLED=1 opens every login wall
# (owner + worker dashboards and all protected APIs) for local testing.
# It is IGNORED by production builds (NODE_ENV=production), so walls are
# always up on deployment. Unset/delete to restore auth. Never enable in
# production.
# ------------------------------------------------------------------
# SUFRA_AUTH_DISABLED=0

# ------------------------------------------------------------------
# NODE_ENV is READ by the app (it hard-disables SUFRA_AUTH_DISABLED and
# switches cookies to `secure`, e.g. src/lib/owner-auth.ts:30) but is MANAGED
# BY NEXT.JS — `next dev` sets "development", `next build`/`next start` set
# "production". Do NOT add it to .env.local: a value here overrides Next's own
# and silently changes which auth walls are up.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# First-run owner signup (OPTIONAL). POST /api/auth/signup treats the
# auto-provisioned placeholder owner as "nobody owns anything yet" and binds
# those restaurants to the new account. Leave unset to use the built-in
# default (owner@sufra.app); set it only if your database was provisioned
# with a different placeholder owner email.
# ------------------------------------------------------------------
# SUFRA_PLACEHOLDER_OWNER_EMAIL=owner@sufra.app

# ------------------------------------------------------------------
# Canonical app URL (OPTIONAL — leave UNSET by default).
#
# When unset, every link the product hands out — password-recovery emails
# (src/app/api/auth/recover/route.ts:10-14), QR codes and invites
# (src/lib/utils.ts:45-62) — is derived from the origin the user actually
# reached. A hard-coded localhost value is worse than no value: it pins those
# links to http://localhost:3000 even when the app is served through ngrok, a
# preview alias, or a deployment URL.
#
# Set it when the printed/accepted links must use a canonical domain that is
# NOT the request origin — e.g. a reverse proxy that rewrites Host internally.
#
# NEXT_PUBLIC_APP_URL=https://your-public-url
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Local URLs for reference (see README).
# App:      http://localhost:3000
# Supabase: http://localhost:54321   (REST + auth API)
# Studio:   http://localhost:54323   (Supabase Studio UI)
# Mail:     http://localhost:54324   (local email catcher)
# ------------------------------------------------------------------
# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — never commit real values
.env
# covers .env.local, .env.development.local, .env.test.local, .env.staging.local, …
.env*.local
*.tsbuildinfo
next-env.d.ts

# supabase CLI scratch state (supabase/config.toml and supabase/migrations/ ARE tracked)
supabase/.branches/
supabase/.temp/

# n8n local data
.n8n/

# n8n phantom directory: nothing in src/ or docker-compose.yml references n8n, but
# the old `./n8n` bind mount made Compose silently create this empty directory.
n8n/

# repowise index / caches
.repowise/

# audit scratch space — docs/audit/*.md are deliverables and stay tracked
docs/audit/_scratch/

# dev server logs
.dev.log
.dev.err.log

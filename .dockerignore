# ------------------------------------------------------------------
# Docker build context exclusions.
# Rule of thumb: the image must NEVER contain real keys, git history,
# audit reports or local tooling artifacts.
# ------------------------------------------------------------------

# --- Dependency caches & build output ---
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo

# --- Env / secrets (never bake real keys into the image) ---
.env
.env*
.env.local
.env.*.local

# --- Git / CI ---
.git/
.gitignore
.github/

# --- Docs & reports (not needed to build; some contain sensitive detail) ---
docs/
*.md
SECURITY-REPORT*.md
PERFORMANCE-*-REPORT.md
FINAL-AGENT*-AUDIT.md

# --- Local tooling artifacts ---
.n8n/
.repowise/
supabase/.temp/
supabase/.branches/

# --- Logs, OS ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.pem
.DS_Store

# Keep what the build actually needs
!src/
!public/
!package.json
!package-lock.json
!tsconfig.json
!tailwind.config.ts
!postcss.config.mjs
!next.config.mjs
